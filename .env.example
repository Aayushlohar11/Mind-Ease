# =============================================================================
# Mind Ease — ENV TEMPLATE
# =============================================================================
# Copy this file to .env.local and fill in your values:
#
#   npm run setup:env
#
# Or manually:
#   cp .env.example .env.local
#
# Then edit .env.local and add your OPENAI_API_KEY.
# =============================================================================

# --- OpenAI (AI Chat) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Auth (Login / Signup) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database Configuration ---
# PostgreSQL Database (Required for production)
DATABASE_URL=postgresql://user:password@localhost:5432/mindease_db

# Alternative individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mindease_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Connection Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# SSL (set to true for production)
DB_SSL=false

# --- Encryption (optional) ---
ENCRYPTION_SECRET=encryption-secret-change-in-production
ENCRYPTION_SALT=encryption-salt-change-in-production

# --- WebSocket (optional) ---
WEBSOCKET_PORT=3001
WEBSOCKET_PATH=/ws

# --- Rate limiting ---
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
